{
  "name": "fortress-frenzy",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time 1v1 castle-destruction brawler (Phaser 3, server-authoritative physics) wrapped with Capacitor",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "test": "node --test tests/*.test.js",
    "server": "npm --prefix server start",
    "test:online": "node --test tests/online.integration.mjs",
    "setup:server": "npm --prefix server install"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "phaser": "^3.80.1",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "vite": "^5.4.0"
  },
  "type": "module"
}
